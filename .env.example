# Copy to .env (gitignored). Share real values privately (password manager / expiring send), never in git or chat screenshots.
# Model keys and the Daytona key are NOT here: enter them in TrueForge -> Settings.

# TrueForge
TRUEFORGE_BASE_URL=http://localhost:8790
AGENT_MODEL=openai/<model-id-from-your-partner-credits>

# release-ops MCP server (binds to 127.0.0.1 only)
MCP_PORT=8787
MCP_SHARED_SECRET=<long-random-string, also set as header auth on the TrueForge connector>

# GitHub: fine-grained PAT, resource owner = our org, repos: tiny-slugify (+ color-helper)
# permissions: Contents RW, Pull requests RW, Issues RW, Metadata R
GITHUB_TOKEN=
GH_ORG=
DEMO_REPO=tiny-slugify
FIXTURE_REPO=color-helper

# npm: granular access token, read+write, limited to our scope, short expiry
NPM_TOKEN=
NPM_SCOPE=

# dry-run for rehearsals, live for the final rehearsal and the judged demo
PUBLISH_MODE=dry-run
